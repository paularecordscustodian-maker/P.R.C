---
import Base from '../layouts/Base.astro';
---
<Base
  title="Page Not Found"
  kicker="404"
  heading="That page isn't in our records"
  lede="The page you're looking for doesn't exist — or moved without leaving a forwarding address. We'd never let that happen to your records."
>
  <section class="section">
    <div class="container">
      <div class="cards">
        <div class="card"><h3>Start over</h3><p>Head back to the home page.</p><a class="more" href="/">Home →</a></div>
        <div class="card"><h3>Free tools</h3><p>Checklists, starter guides, and the Request Builder.</p><a class="more" href="/resources">Resources →</a></div>
        <div class="card"><h3>Talk to PRC</h3><p>Book a consultation about your records.</p><a class="more" href="/consultation">Book a time →</a></div>
      </div>
    </div>
  </section>
</Base>
