---
import Base from '../layouts/Base.astro';
---
<Base
  title="Industries"
  kicker="Industries"
  heading="Who we serve on the business side"
  lede="Records readiness for the organizations where missing proof costs the most."
>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div class="kicker">Featured Lane</div>
        <h2>Property ownership transitions</h2>
        <p>
          Our first specialty: newly acquired apartment complexes, mobile-home parks,
          manufactured-housing communities, and newly appointed management companies.
          When ownership or management changes hands, the records rarely arrive complete.
        </p>
      </div>
      <div class="cards">
        <div class="card">
          <h3>What typically transfers (incomplete)</h3>
          <ul class="list-plain">
            <li>Leases, renewals, and addenda</li>
            <li>Resident ledgers, deposits, receipts, assistance payments, opening balances</li>
            <li>Rent and fee authority</li>
            <li>Maintenance requests, work orders, inspections, photos, vendor invoices</li>
            <li>Resident notices and proof of delivery</li>
            <li>Complaints, incidents, towing, insurance, and vendor records</li>
            <li>Employee responsibility and access records</li>
            <li>Exports from prior property-management systems</li>
          </ul>
        </div>
        <div class="card">
          <h3>What PRC delivers</h3>
          <ul class="list-check">
            <li>Transferred-record inventory</li>
            <li>Missing-record report</li>
            <li>Unresolved-item tracker</li>
            <li>Digital folder structure &amp; document index</li>
            <li>Proof-of-connection table</li>
            <li>Open-maintenance and incident tracker</li>
            <li>30-, 60-, and 90-day transition plan</li>
          </ul>
          <a class="more" href="/consultation">Book a transition review →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <div class="section-head">
        <div class="kicker">All Business &amp; Commercial Markets</div>
        <h2>Industries we serve</h2>
      </div>
      <div class="cards">
        <div class="card"><h3>Property &amp; Real Estate</h3><p>Apartment owners, property-management companies, mobile-home parks, manufactured-housing communities, real-estate investors, and small property owners.</p></div>
        <div class="card"><h3>Construction &amp; Trades</h3><p>Construction and skilled-trade companies where job records, inspections, and completion proof decide who gets paid.</p></div>
        <div class="card"><h3>Trucking &amp; Logistics</h3><p>Carriers, logistics companies, and owner-operators managing compliance, maintenance, and delivery records.</p></div>
        <div class="card"><h3>Care &amp; Community Services</h3><p>Provider services, home-care, childcare, and community-service organizations with records obligations to families and agencies.</p></div>
        <div class="card"><h3>Churches &amp; Nonprofits</h3><p>Churches, ministries, nonprofits, and community organizations preserving governance, donation, and program records.</p></div>
        <div class="card"><h3>Small Business</h3><p>Retailers, salons, beauty businesses, restaurants, and professional offices that need proof ready for landlords, lenders, and licensing.</p></div>
        <div class="card"><h3>Government Contractors</h3><p>Companies preparing for funding, grants, contracts, audits, or inspections — with the evidence room already built.</p></div>
      </div>
    </div>
  </section>
</Base>
