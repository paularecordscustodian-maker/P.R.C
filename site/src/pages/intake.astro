---
import Base from '../layouts/Base.astro';
---
<Base
  title="Client Intake"
  kicker="Client Intake"
  heading="Tell us about your records"
  lede="This form starts the readiness conversation. Please do not upload or paste sensitive documents — we'll establish secure handling first."
>
  <section class="section">
    <div class="container">
      <form class="form" id="intake-form" onsubmit="return false;">
        <input type="text" name="website" id="hp" tabindex="-1" autocomplete="off" style="position:absolute; left:-9999px;" aria-hidden="true" />
        <div class="row">
          <div>
            <label for="name">Full name</label>
            <input id="name" name="name" type="text" placeholder="Your name" />
          </div>
          <div>
            <label for="org">Organization (if any)</label>
            <input id="org" name="org" type="text" placeholder="Business, nonprofit, or church" />
          </div>
        </div>
        <div class="row">
          <div>
            <label for="email">Email</label>
            <input id="email" name="email" type="email" placeholder="you@example.com" />
          </div>
          <div>
            <label for="phone">Phone</label>
            <input id="phone" name="phone" type="tel" placeholder="(555) 555-5555" />
          </div>
        </div>
        <div>
          <label for="type">What best describes you?</label>
          <select id="type" name="type">
            <option>Property owner / management company</option>
            <option>Business or nonprofit</option>
            <option>Individual or family</option>
            <option>Community partner (school, church, program)</option>
            <option>Other</option>
          </select>
        </div>
        <div>
          <label for="situation">What's happening with your records?</label>
          <textarea id="situation" name="situation" rows="5" placeholder="Example: We just acquired a 120-unit property and the prior manager's records are incomplete…"></textarea>
        </div>
        <p class="note">
          Do not include account numbers, government ID numbers, or medical details in this form.
          General descriptions are enough to get started. See our
          <a href="/records-handling">Records Handling Notice</a>.
        </p>
        <div>
          <button class="btn" type="submit" id="submit-btn">Submit intake</button>
          <p class="note" id="form-msg" style="margin-top:0.6rem;"></p>
        </div>
      </form>
      <div class="wire-box" id="done" style="display:none; max-width:640px;">
        <div class="big">Received — thank you.</div>
        <p>PRC reviews every intake personally. You'll hear back at the email you provided,
        usually within two business days. Want to pick a time now?
        <a href="/consultation">Request a consultation slot</a>.</p>
      </div>
    </div>
  </section>

  <script>
    const f = document.querySelector('#intake-form');
    f.addEventListener('submit', async () => {
      const btn = document.querySelector('#submit-btn');
      btn.disabled = true;
      const val = (id) => f.querySelector('#' + id)?.value ?? '';
      const r = await fetch('/api/intake', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: val('name'), org: val('org'), email: val('email'), phone: val('phone'),
          type: val('type'), situation: val('situation'), website: val('hp'),
        }),
      }).then(x => x.json()).catch(() => ({ ok: false, error: 'Network error — try again.' }));
      if (r.ok) { f.style.display = 'none'; document.querySelector('#done').style.display = ''; }
      else { document.querySelector('#form-msg').textContent = r.error || 'Something went wrong.'; btn.disabled = false; }
    });
  </script>
</Base>
