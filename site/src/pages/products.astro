---
import Base from '../layouts/Base.astro';
import { products } from '../data/products';
---
<Base
  title="Products"
  kicker="Products"
  heading="Tools you can hold, teach with, and grow into"
  lede="Physical and digital products that make records readiness a habit — starting in childhood. Order online; PRC confirms totals and payment by email."
>
  <section class="section">
    <div class="container">
      <div class="cards">
        {products.map((p) => (
          <div class="card">
            <div class="num">{p.price !== null ? `$${p.price.toFixed(2)}` : p.priceNote}</div>
            <h3>{p.name}</h3>
            <p>{p.desc}</p>
            <a class="more" href={`/order?p=${p.slug}`}>Order →</a>
          </div>
        ))}
        <div class="card">
          <div class="num">Free EPUB</div>
          <h3>The Starter Handbook E-Book</h3>
          <p>The seven-category checklists as a free e-book. Members of the Library also get the complete guide collection as an EPUB.</p>
          <a class="more" href="/api/ebook">Download free →</a>
        </div>
        <div class="card">
          <div class="num">Free</div>
          <h3>Checklists, Worksheets &amp; Request Letters</h3>
          <p>The seven category checklists and the Records Request Builder are free for everyone — start there today.</p>
          <a class="more" href="/resources">See free resources →</a>
        </div>
        <div class="card">
          <div class="num">Membership</div>
          <h3>Records Readiness Library</h3>
          <p>In-depth member guides that turn checklists into finished systems — join, or gift a year to someone starting out.</p>
          <a class="more" href="/library">Explore the Library →</a>
        </div>
      </div>
      <p style="margin-top:2rem;">
        <a class="btn" href="/order">Place an order</a>
      </p>
    </div>
  </section>
</Base>
