---
import Base from '../layouts/Base.astro';
---
<Base
  title="Products"
  kicker="Products"
  heading="Tools you can hold, teach with, and grow into"
  lede="Physical and digital products that make records readiness a habit — starting in childhood."
>
  <section class="section">
    <div class="container">
      <div class="cards">
        <div class="card">
          <h3>Children's Piggy Bank Papers &amp; Progress Book</h3>
          <p>A keepsake book that teaches children to keep their first records — money, milestones, and papers that matter.</p>
          <span class="wire" data-wire="product-order">Ordering coming soon</span>
        </div>
        <div class="card">
          <h3>Youth Money, Papers &amp; Progress Keepsake Book</h3>
          <p>For teens and young adults: first accounts, first paychecks, first credentials — recorded and kept.</p>
          <span class="wire" data-wire="product-order">Ordering coming soon</span>
        </div>
        <div class="card">
          <h3>E-Books</h3>
          <p>Guides by record category, life event, industry, and audience — practical, plain-language, and checklist-driven.</p>
          <span class="wire" data-wire="product-ebooks">Catalog coming soon</span>
        </div>
        <div class="card">
          <h3>Checklists, Worksheets &amp; Templates</h3>
          <p>Guides, templates, and request-letter libraries for every readiness situation.</p>
          <a class="more" href="/resources">See free resources →</a>
        </div>
        <div class="card">
          <h3>Accordion-File &amp; Expanding-File Systems</h3>
          <p>Physical filing systems pre-labeled on the PRC seven-category framework — readiness you can put on a shelf.</p>
          <span class="wire" data-wire="product-order">Ordering coming soon</span>
        </div>
        <div class="card">
          <h3>Workshops, Webinars &amp; Courses</h3>
          <p>Community presentations and courses for schools, churches, nonprofits, and workforce programs.</p>
          <a class="more" href="/partnerships">Book a workshop →</a>
        </div>
      </div>
    </div>
  </section>
</Base>
