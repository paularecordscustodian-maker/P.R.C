---
import Base from '../layouts/Base.astro';
---
<Base
  title="Resources"
  kicker="Resources"
  heading="Free tools to start getting ready"
  lede="Checklists, guides, and worksheets built on the PRC seven-category framework. Educational resources — see our Service Boundaries."
>
  <section class="section">
    <div class="container">
      <div class="cards">
        <div class="card">
          <h3>Records Readiness Checklists</h3>
          <p>Category-by-category checklists: identity, health, financial, housing, employment, legal, and family records.</p>
          <span class="wire" data-wire="download-checklists">Downloads coming soon</span>
        </div>
        <div class="card">
          <h3>Life Event Guides</h3>
          <p>What records to gather for a first apartment, a new job, caregiving, retirement, reentry, or the loss of a loved one.</p>
          <span class="wire" data-wire="download-guides">Downloads coming soon</span>
        </div>
        <div class="card">
          <h3>Records Request Center</h3>
          <p>A request-letter library and Request Builder to help you ask agencies, employers, schools, and providers for copies of your own records.</p>
          <span class="wire" data-wire="request-builder">Request Builder coming soon</span>
        </div>
        <div class="card">
          <h3>Business Transition Worksheets</h3>
          <p>What to demand in the data room when buying a property or business — the records that should transfer with the keys.</p>
          <span class="wire" data-wire="download-worksheets">Downloads coming soon</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <div class="section-head">
        <div class="kicker">Go Deeper</div>
        <h2>The Records Readiness Library</h2>
        <p>Our full library of e-books, templates, courses, and the request-letter collection — organized by record category, life event, industry, and audience.</p>
      </div>
      <a class="btn dark" href="/library">Explore the Library</a>
    </div>
  </section>
</Base>
