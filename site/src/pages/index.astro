---
import Base from '../layouts/Base.astro';
---
<Base title="Records Readiness for People, Families & Businesses">
  <section class="hero grain">
    <div class="orb orb-a"></div>
    <div class="orb orb-b"></div>
    <div class="container inner">
      <div>
        <div class="kicker">Paula Records Custodian LLC</div>
        <h1>Before there is a dispute, there should be <span class="serif-accent">a record.</span></h1>
        <p class="lede">
          PRC is a Records Readiness company. We help people, families, businesses, nonprofits, and
          organizations identify, organize, preserve, track, retrieve, and connect the records that
          matter — so you are prepared for opportunities, responsibilities, transitions, emergencies,
          and requests for proof.
        </p>
        <div class="actions">
          <a class="btn" href="/consultation">Book a Consultation</a>
          <a class="btn ghost" href="/services">Explore Services</a>
        </div>
      </div>
      <div class="stack3d" aria-hidden="true">
        <div class="doc-card doc-1">
          <div class="dc-title"><span class="dot"></span> Lease Agreement — Unit 204</div>
          <div class="dc-line"></div>
          <div class="dc-line short"></div>
          <div class="dc-badge">Verified · Connected</div>
        </div>
        <div class="doc-card doc-2">
          <div class="dc-title"><span class="dot"></span> Deposit Ledger — 2026</div>
          <div class="dc-line"></div>
          <div class="dc-line short"></div>
          <div class="dc-badge">Indexed</div>
        </div>
        <div class="doc-card doc-3">
          <div class="dc-title"><span class="dot"></span> Proof of Delivery — Notice</div>
          <div class="dc-line"></div>
          <div class="dc-line short"></div>
          <div class="dc-badge">Retrieved in 12s</div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div class="kicker">The Problem</div>
        <h2>Records are scattered. Proof goes missing.</h2>
        <p>
          Records live across paper files, email, phones, cloud drives, software platforms, prior
          managers, vendors, agencies, and family members. Most people and organizations don't know:
        </p>
      </div>
      <div class="bento">
        <div class="card dark wide">
          <h3>What happens next</h3>
          <p>How do you retrieve records quickly — and keep operating if one person, system, device, or office becomes unavailable? Continuity is the difference between a bad week and a shutdown.</p>
        </div>
        <div class="card"><h3>What exists</h3><p>What records exist, and where they are actually stored.</p></div>
        <div class="card"><h3>What's missing</h3><p>Which records are missing — before an audit, dispute, or emergency finds out for you.</p></div>
        <div class="card wide"><h3>What connects</h3><p>Which record supports a charge, payment, decision, event, or responsibility — and which charges have no record behind them at all.</p></div>
      </div>
    </div>
  </section>

  <section class="stats-band grain">
    <div class="container row">
      <div class="stat"><div class="v">7</div><div class="l">Universal record categories</div></div>
      <div class="stat"><div class="v">30 / 60 / 90</div><div class="l">Day transition plans</div></div>
      <div class="stat"><div class="v">15</div><div class="l">Services, business &amp; life</div></div>
      <div class="stat"><div class="v">100%</div><div class="l">Human-reviewed conclusions</div></div>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <div class="section-head">
        <div class="kicker">The PRC Framework</div>
        <h2>Seven universal record categories</h2>
        <p>Every PRC system — client folders, digital systems, checklists, and courses — is built on the same dependable framework.</p>
      </div>
      <div class="framework">
        <div class="cat"><div class="n">1</div><div class="t">Identity</div></div>
        <div class="cat"><div class="n">2</div><div class="t">Health &amp; Care</div></div>
        <div class="cat"><div class="n">3</div><div class="t">Financial</div></div>
        <div class="cat"><div class="n">4</div><div class="t">Housing &amp; Property</div></div>
        <div class="cat"><div class="n">5</div><div class="t">Employment &amp; Education</div></div>
        <div class="cat"><div class="n">6</div><div class="t">Legal &amp; Important Documents</div></div>
        <div class="cat"><div class="n">7</div><div class="t">Personal &amp; Family</div></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div class="kicker">Who We Serve</div>
        <h2>Businesses, families, and everything in between</h2>
      </div>
      <div class="cards">
        <div class="card">
          <h3>Property &amp; Business</h3>
          <p>New ownership records transitions for apartment complexes, mobile-home parks, and management companies. Records health checks, continuity plans, and handoff reviews for any business.</p>
          <a class="more" href="/services">Business services →</a>
        </div>
        <div class="card">
          <h3>Individuals &amp; Families</h3>
          <p>First apartment, first job, caregiving, retirement, reentry, estate, and family-history records — organized before life asks for proof.</p>
          <a class="more" href="/life-transitions">Life transition services →</a>
        </div>
        <div class="card">
          <h3>Community Partners</h3>
          <p>Schools, churches, nonprofits, workforce programs, and professional partners bringing records readiness to the people they serve.</p>
          <a class="more" href="/partnerships">Partnerships →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <div class="section-head">
        <div class="kicker">What We Believe</div>
        <h2>Signature statements</h2>
      </div>
      <div class="statements">
        <div class="statement">People often do not realize the value of a record until they need it.</div>
        <div class="statement">Organize for today. Prepare for tomorrow. Preserve for the future.</div>
        <div class="statement">A tool is not the service. A folder is not the system. Storage is not preparedness.</div>
      </div>
    </div>
  </section>
</Base>
