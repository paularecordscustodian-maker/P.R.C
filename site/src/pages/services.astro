---
import Base from '../layouts/Base.astro';
---
<Base
  title="Services"
  kicker="Services"
  heading="Business records readiness services"
  lede="From a first health check to full records continuity — every service builds toward one goal: a dependable records system."
>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div class="kicker">Core Services</div>
        <h2>Start here</h2>
      </div>
      <div class="cards">
        <div class="card">
          <div class="num">01</div>
          <h3>Records Health Check</h3>
          <p>A structured review of what records you have, where they live, what's missing, and what to fix first. The starting point for every engagement.</p>
        </div>
        <div class="card">
          <div class="num">02</div>
          <h3>New Ownership Records Transition Review</h3>
          <p>For newly acquired properties and businesses: inventory the transferred records, report what's missing, track unresolved items, and deliver a 30/60/90-day transition plan.</p>
        </div>
        <div class="card">
          <div class="num">03</div>
          <h3>Key-Person &amp; Employee Handoff Review</h3>
          <p>When a key person leaves or changes roles: capture what they hold, document responsibilities and access, and make the handoff dependable.</p>
        </div>
        <div class="card">
          <div class="num">04</div>
          <h3>Software Exit Records Package</h3>
          <p>Leaving a property-management system, CRM, or accounting platform? We extract, organize, and index your records before access disappears.</p>
        </div>
        <div class="card">
          <div class="num">05</div>
          <h3>Business Records Continuity Plan</h3>
          <p>A written plan so your organization keeps operating if one person, system, device, or office becomes unavailable.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <div class="section-head">
        <div class="kicker">Advanced Services</div>
        <h2>Deepen your readiness</h2>
      </div>
      <div class="cards">
        <div class="card">
          <div class="num">06</div>
          <h3>Business Records Continuity Vault</h3>
          <p>A maintained, organized, access-controlled vault of the records your business cannot afford to lose.</p>
        </div>
        <div class="card">
          <div class="num">07</div>
          <h3>Insurance &amp; Loss Records Organizer</h3>
          <p>Policies, schedules, proof of condition, and loss documentation — organized before you ever need to file a claim.</p>
        </div>
        <div class="card">
          <div class="num">08</div>
          <h3>Funding, Grant &amp; Contract Evidence Room</h3>
          <p>The records that funders, agencies, and auditors ask for — assembled, indexed, and connected to the activities they prove.</p>
        </div>
        <div class="card">
          <div class="num">09</div>
          <h3>Dispute Records Organizer</h3>
          <p>When a dispute is coming, we organize the records that tell your side — chronologies, indexes, and proof-of-connection tables for your professionals to use.</p>
        </div>
        <div class="card">
          <div class="num">10</div>
          <h3>Proof-of-Connection Review</h3>
          <p>Connect every charge, payment, decision, and event to the record that supports it — and flag the ones that have no support.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div class="kicker">Ongoing Support</div>
        <h2>Monthly service levels</h2>
        <p>Recurring support, sized by written scope — entities, properties, units, accounts, transactions, documents, users, and storage volume. Final pricing published soon.</p>
      </div>
      <ul class="list-check" style="columns: 2; column-gap: 3rem; max-width: 60rem;">
        <li>Records Organization</li>
        <li>Records &amp; Bookkeeping Readiness Support</li>
        <li>Property Records Management</li>
        <li>Annual Records Health Check</li>
        <li>Business Continuity Membership</li>
        <li>Life Ready Membership</li>
        <li>Records Readiness Library subscription</li>
      </ul>
      <p style="margin-top:1.5rem;"><a class="btn" href="/pricing">See published pricing</a></p>
    </div>
  </section>
</Base>
