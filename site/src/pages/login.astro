---
import Base from '../layouts/Base.astro';
---
<Base
  title="Client Login"
  kicker="Client Login"
  heading="Client portal"
  lede="Existing clients will access their records systems, trackers, and reports here."
>
  <section class="section">
    <div class="container">
      <div class="wire-box" data-wire="client-portal-auth" style="max-width: 560px;">
        <div class="big">The secure client portal is under construction</div>
        <p>
          When it opens, clients will sign in here to view their document index, missing-record
          reports, unresolved-item trackers, and monthly readiness reports — protected by
          multifactor authentication and role-based access.
        </p>
        <p style="margin-top:1rem;">
          Current clients receive deliverables directly and securely in the meantime.
        </p>
        <p style="margin-top:1rem;"><a class="btn" href="/consultation">Become a Client</a></p>
      </div>
    </div>
  </section>
</Base>
