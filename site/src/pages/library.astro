---
import Base from '../layouts/Base.astro';
---
<Base
  title="Records Readiness Library"
  kicker="Records Readiness Library"
  heading="Every guide, template, and letter in one place"
  lede="A growing library organized by record category, life event, industry, and audience."
>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div class="kicker">Browse By</div>
        <h2>Four ways in</h2>
      </div>
      <div class="cards">
        <div class="card">
          <h3>By Record Category</h3>
          <p>Identity · Health &amp; Care · Financial · Housing &amp; Property · Employment &amp; Education · Legal &amp; Important Documents · Personal &amp; Family.</p>
        </div>
        <div class="card">
          <h3>By Life Event</h3>
          <p>First apartment · first job · new parent · caregiving · retirement · reentry · estate and loss · military and workforce transitions.</p>
        </div>
        <div class="card">
          <h3>By Industry</h3>
          <p>Property management · construction · trucking · care services · churches and nonprofits · small business · government contracting.</p>
        </div>
        <div class="card">
          <h3>By Audience</h3>
          <p>Children and teens · young adults · families · seniors · business owners · community organizations.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <div class="wire-box" data-wire="library-subscription">
        <div class="big">Library access is being prepared</div>
        <p>E-books, checklists, worksheets, request-letter templates, and courses are being assembled now.
        A subscription option is planned. Check back soon, or book a consultation to get materials directly.</p>
        <p style="margin-top:1rem;"><a class="btn" href="/consultation">Book a Consultation</a></p>
      </div>
    </div>
  </section>
</Base>
