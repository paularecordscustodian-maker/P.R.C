---
import Base from '../layouts/Base.astro';
---
<Base
  title="Book a Consultation"
  kicker="Book a Consultation"
  heading="Talk with PRC about your records"
  lede="A consultation is a conversation about where your records stand and what readiness would look like — no obligation."
>
  <section class="section">
    <div class="container">
      <div class="cards" style="grid-template-columns: 1.2fr 1fr;">
        <div>
          <h2 style="margin-bottom:1rem;">What to expect</h2>
          <ul class="list-check">
            <li>A short conversation about your situation — business transition, life event, or general readiness.</li>
            <li>A plain-language explanation of which PRC service fits, if any.</li>
            <li>A written scope before any engagement begins — no surprises.</li>
            <li>No legal, tax, accounting, or medical advice — see <a href="/service-boundaries">Service Boundaries</a>.</li>
          </ul>
          <p style="margin-top:1.2rem; color:var(--muted);">
            Prefer to start in writing? Fill out the <a href="/intake">client intake form</a> and we'll reach out.
          </p>
        </div>
        <div>
          <form class="form card" id="bk-form" onsubmit="return false;" style="padding:1.7rem;" data-wire="calcom-embed-optional">
            <h3>Request a consultation</h3>
            <input type="text" id="bk-hp" tabindex="-1" autocomplete="off" style="position:absolute; left:-9999px;" aria-hidden="true" />
            <div><label for="bk-name">Name</label><input id="bk-name" type="text" placeholder="Your name" /></div>
            <div><label for="bk-email">Email</label><input id="bk-email" type="email" placeholder="you@example.com" /></div>
            <div><label for="bk-phone">Phone (optional)</label><input id="bk-phone" type="tel" placeholder="(555) 555-5555" /></div>
            <div>
              <label for="bk-topic">What's it about?</label>
              <select id="bk-topic">
                <option>Property / business transition</option>
                <option>Business records health check</option>
                <option>Life transition (family, caregiving, fresh start…)</option>
                <option>Partnership / workshop</option>
                <option>Something else</option>
              </select>
            </div>
            <div><label for="bk-times">Days/times that work for you</label><input id="bk-times" type="text" placeholder="e.g. weekday mornings, or Tue/Thu after 5pm" /></div>
            <button class="btn" id="bk-go">Request consultation</button>
            <p class="note" id="bk-msg"></p>
          </form>
          <div class="wire-box" id="bk-done" style="display:none;">
            <div class="big">Request received.</div>
            <p>PRC will confirm a time by email — usually within one business day.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    document.querySelector('#bk-go').addEventListener('click', async () => {
      const v = (id) => document.querySelector('#' + id).value;
      const btn = document.querySelector('#bk-go');
      btn.disabled = true;
      const r = await fetch('/api/booking', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: v('bk-name'), email: v('bk-email'), phone: v('bk-phone'),
          topic: v('bk-topic'), pref_times: v('bk-times'), website: v('bk-hp'),
        }),
      }).then(x => x.json()).catch(() => ({ ok: false, error: 'Network error — try again.' }));
      if (r.ok) {
        document.querySelector('#bk-form').style.display = 'none';
        document.querySelector('#bk-done').style.display = '';
      } else {
        document.querySelector('#bk-msg').textContent = r.error || 'Something went wrong.';
        btn.disabled = false;
      }
    });
  </script>
</Base>
