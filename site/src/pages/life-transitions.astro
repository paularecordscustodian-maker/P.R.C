---
import Base from '../layouts/Base.astro';
---
<Base
  title="Life Transition Services"
  kicker="Life Transition Services"
  heading="Records readiness for every stage of life"
  lede="Life's biggest moments come with paperwork. We help individuals and families get ready before the moment arrives."
>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div class="kicker">Starting Out</div>
        <h2>First steps into independence</h2>
      </div>
      <div class="cards">
        <div class="card"><h3>Independent Living Records Kit</h3><p>For young adults stepping out on their own — including those aging out of foster care or transitioning from adoption support.</p></div>
        <div class="card"><h3>First Apartment Records Kit</h3><p>Applications, leases, deposits, condition photos, renter's insurance — everything a first-time renter should keep and why.</p></div>
        <div class="card"><h3>First Job Records Kit</h3><p>Offer letters, pay stubs, tax documents, benefits, and credentials — organized from day one of working life.</p></div>
        <div class="card"><h3>Student Loan &amp; Education Records</h3><p>Enrollment, loans, transcripts, and certificates for college and trade-school students — connected and retrievable.</p></div>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <div class="section-head">
        <div class="kicker">Family &amp; Care</div>
        <h2>Caring for the people who matter</h2>
      </div>
      <div class="cards">
        <div class="card"><h3>Family Records Readiness</h3><p>A household system across all seven PRC categories — identity, health, financial, housing, employment, legal, and family records.</p></div>
        <div class="card"><h3>Caregiver &amp; Health Records</h3><p>For new parents and caregivers: health histories, benefits, appointments, and care decisions with the proof to support them.</p></div>
        <div class="card"><h3>Senior &amp; Retirement Records</h3><p>For seniors, veterans, and retirees — benefits, pensions, healthcare, and property records organized while it's easy.</p></div>
        <div class="card"><h3>Estate &amp; Family History</h3><p>Loss-of-loved-one records, estate documents, keepsakes, property records, and family history — preserved for the next generation.</p></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div class="kicker">Fresh Starts &amp; Transitions</div>
        <h2>New chapters</h2>
      </div>
      <div class="cards">
        <div class="card"><h3>Fresh Start / Reentry Records Organizer</h3><p>For returning citizens and families supporting incarcerated loved ones — identity, benefits, housing, and employment records for a working fresh start.</p></div>
        <div class="card"><h3>Community Supervision Records</h3><p>Where applicable: organized proof of compliance, appointments, payments, and program completion.</p></div>
        <div class="card"><h3>Military, Veteran &amp; Workforce Transition</h3><p>Service records, overseas-employment records, credentials, and benefits for career transitions.</p></div>
        <div class="card">
          <h3>PRC Life Ready Initiative</h3>
          <p>Records readiness education delivered through schools, nonprofits, churches, workforce programs, and community organizations.</p>
          <a class="more" href="/partnerships">Partner with us →</a>
        </div>
      </div>
    </div>
  </section>
</Base>
